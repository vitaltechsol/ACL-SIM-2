<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ACL_SIM_2</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>images\acl_logo_transparent.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="images\acl_logo_transparent-small.png" />
    <Resource Include="images\acl_logo_transparent.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
    <None Include="ACL-SIM-2.Tests\ACL-SIM-2.Tests.csproj" />
  </ItemGroup>

  <!-- Exclude the nested test project from main project compilation -->
  <ItemGroup>
    <Compile Remove="ACL-SIM-2.Tests\**" />
    <EmbeddedResource Remove="ACL-SIM-2.Tests\**" />
    <None Remove="ACL-SIM-2.Tests\**" />
    <Page Remove="ACL-SIM-2.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EasyModbusTCP" Version="5.6.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="System.IO.Ports" Version="7.0.0" />
    <PackageReference Include="System.ServiceModel.Duplex" Version="4.10.3" />
    <PackageReference Include="System.ServiceModel.NetTcp" Version="4.10.3" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="4.10.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ProSimSDK">
      <HintPath>ProSimSDK.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="MANUAL.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
